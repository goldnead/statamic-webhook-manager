# Files excluded from the distributed package (dist tarball) — they are
# dev/CI/marketplace tooling and not needed at runtime.
#
# The compiled CP assets under resources/dist/build/ ARE shipped (Statamic
# publishes them to the host's public/vendor/ on install). Their sources are
# not: resources/js and resources/css are ~5,800 lines no install reads, and
# shipping them without node_modules only invites someone to run `npm run
# build` inside vendor/.
/.github               export-ignore
/.devcontainer         export-ignore
/scripts               export-ignore
/tests                 export-ignore
/docs                  export-ignore
/playground            export-ignore
/vendor                export-ignore
/node_modules          export-ignore
/.editorconfig         export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/phpunit.xml           export-ignore
/phpunit.xml.dist      export-ignore
/phpunit.mysql.xml     export-ignore
/pint.json             export-ignore
/phpstan.neon          export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json       export-ignore
/package.json          export-ignore
/package-lock.json     export-ignore
/vite.config.js        export-ignore
/resources/js          export-ignore
/resources/css         export-ignore
/MARKETPLACE.md        export-ignore
/art                   export-ignore

# Deliberately kept: /resources/dist, /config, /resources/lang, /routes, /src,
# /database, /screenshots (the README embeds them), README.md, CHANGELOG.md,
# LICENSE.

*.md text eol=lf
*.svg text eol=lf
*.php text eol=lf
*.json text eol=lf
