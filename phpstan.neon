includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Level 5 with a generated baseline, deliberately. The point of static
    # analysis here is a ratchet on new code, not a rewrite of 14,000 existing
    # lines: anything already in the baseline stays as it is, anything new has
    # to be clean. Raise the level (and regenerate) when the baseline is small
    # enough that the next step is cheap.
    level: 5

    paths:
        - src

    excludePaths:
        - src/../resources/dist

    treatPhpDocTypesAsCertain: false

    # Das Analytics-Addon ist ein `suggest`, kein `require`: die Kennzahlen
    # unter src/Integrations/Insights erweitern seinen Vertrag, und es liegt
    # nicht in vendor/. Gelesen werden die Stellvertreter aus der Testsuite —
    # dieselben Deklarationen, Byte fuer Byte —, damit die Kennzahlen gegen die
    # echten Signaturen geprueft werden statt als unbekannte Klassen zu gelten.
    # Gescannt, nicht analysiert: die Dateien sind kein Code, den dieses Paket
    # ausliefert.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php
