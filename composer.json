{
    "name": "goldnead/statamic-webhook-manager",
    "description": "Statamic 6 Webhook Manager — central CP-native integration layer for outbound hooks, inbound endpoints, deliveries, retries, rules and templates.",
    "type": "statamic-addon",
    "license": "MIT",
    "homepage": "https://github.com/goldnead/statamic-webhook-manager",
    "keywords": [
        "statamic",
        "statamic-addon",
        "webhooks",
        "integration",
        "automation"
    ],
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-webhook-manager/issues",
        "source": "https://github.com/goldnead/statamic-webhook-manager"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/goldnead/statamic-brand-context.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "goldnead/statamic-brand-context": "^1.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "statamic/cms": "^6.0"
    },
    "suggest": {
        "goldnead/statamic-leadhub": "Turn inbound webhook payloads into CRM contacts via the upsert_lead inbound action",
        "goldnead/statamic-automations": "Orchestrate multi-step workflows that send webhooks through Webhook Manager"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\WebhookManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\WebhookManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "slug": "webhook-manager",
            "name": "Webhook Manager",
            "description": "Central integration layer for inbound and outbound webhooks with deliveries, retries, rules and templates.",
            "url": "https://github.com/goldnead/statamic-webhook-manager",
            "developer": "Adrian Goldner",
            "developer-url": "https://gldnr.studio"
        },
        "laravel": {
            "providers": [
                "Goldnead\\WebhookManager\\WebhookManagerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
